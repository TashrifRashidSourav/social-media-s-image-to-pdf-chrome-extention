{
  "manifest_version": 3,
  "name": "Image to PDF Scanner",
  "version": "1.0.0",
  "description": "Capture all images of a LinkedIn/Facebook (or any) post, clean them up like CamScanner, and export a page-by-page PDF.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "downloads", "identity", "unlimitedStorage", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Image to PDF", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "capture-post": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Capture all images of the post under the mouse"
    },
    "drag-select": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Drag-select images on the page"
    },
    "open-editor": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Open the PDF editor / basket"
    }
  },
  "sandbox": { "pages": ["cvsandbox.html"] },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
