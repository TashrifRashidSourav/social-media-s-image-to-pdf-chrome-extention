{
  "manifest_version": 3,
  "name": "Image to PDF Scanner",
  "short_name": "Image to PDF",
  "version": "1.0.0",
  "description": "Turn images from posts, chats and web pages into a clean, page-by-page PDF. Auto-crop, enhance and OCR, all offline.",
  "minimum_chrome_version": "110",
  "permissions": ["scripting", "storage", "contextMenus"],
  "optional_permissions": ["debugger"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Image to PDF Scanner",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "capture-post": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Capture all images of the post under the mouse"
    },
    "drag-select": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Drag-select images on the page"
    },
    "open-editor": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Open the PDF editor / basket"
    }
  },
  "sandbox": { "pages": ["cvsandbox.html"] },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
